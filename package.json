{
  "name": "dark-flip-timer",
  "productName": "Dark Flip Timer",
  "description": "Standalone dark-themed split-flap countdown timer & acoustic focus desktop application for Windows by TanCreative",
  "author": "TanCreative",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/contacttancrea-cmyk/Dark-flip-timer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/contacttancrea-cmyk/Dark-flip-timer.git"
  },
  "bugs": {
    "url": "https://github.com/contacttancrea-cmyk/Dark-flip-timer/issues"
  },
  "version": "1.1.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-icons.mjs && vite build",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-icons.mjs",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "electron:start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.json",
    "dist:win:portable": "npm run build && electron-builder --win portable --config electron-builder.json",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
